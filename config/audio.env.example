# AUTO ігнорує auto_null та службові шини. Автовибір не надає переваги USB/I2S/PCI:
# спочатку використовується активний фізичний sink, інакше стабільний fallback за назвою.
# Явний вибір з Web UI зберігається окремо у /var/lib/proaudio-player-alert/audio-output.env.
PHYSICAL_SINK=AUTO

# Mixed domain за замовчуванням працює в adaptive mode. PipeWire може
# перемикати graph/device rate між дозволеними сімействами, коли це безпечно,
# а логічні MUSIC/ALERT/MASTER шини не прив'язані до одного rate.
#
# SAMPLE_RATE є fallback/default rate, а не примусовою частотою в adaptive mode.
# Якщо конкретний source або DAC не підтримує поточний graph rate, PipeWire робить
# boundary resampling. У fixed mode graph примусово лишається на SAMPLE_RATE.
SAMPLE_RATE_MODE=adaptive
SAMPLE_RATE=48000
ALLOWED_SAMPLE_RATES=44100,48000,88200,96000,176400,192000
AUDIO_CHANNELS=2

MUSIC_SINK=proaudio_player_music
ALERT_SINK=proaudio_player_alert
MASTER_SINK=proaudio_player_master
PARKING_SINK=proaudio_player_parking

# Внутрішні MUSIC/ALERT/MASTER та фінальний MASTER->hardware link працюють як
# штатні PipeWire/Pulse graph links. Тут немає окремого userspace PCM relay/DSP bridge.
# Для мережевого аудіоплеєра стабільність і безперервність clock domain важливіші
# за мінімальну latency, тому 100 ms є консервативним значенням для appliance.
LOOPBACK_LATENCY_MSEC=100

# Фізичний PipeWire/Pulse sink завжди unity. Користувацька MASTER-гучність живе
# тільки на MASTER_SINK. Значення, відмінне від 100, вважається помилкою.
OUTPUT_VOLUME_PERCENT=100

# MUSIC->MASTER, ALERT->MASTER і MASTER->hardware завжди мають unity gain.
# Нормальне відтворення при MUSIC=MASTER=100% тому проходить без прихованого
# підсилення або ослаблення. ALERT завжди лишається на заданому користувачем
# рівні; під час повідомлення native control plane за потреби додатково приглушує
# лише MUSIC, щоб сума двох full-scale джерел не перевищувала лінійний peak-бюджет.

# unity: ініціалізувати лише достовірні ALSA playback-контроли біля 0 dB без positive gain.
# Якщо 0 dB мапиться на 0% (помилкова/нетипова USB dB-шкала), такий control не
# приймається за unity і попередній raw-рівень відновлюється. Невідомі контроли не вгадуються.
# off: взагалі не торкатися апаратного ALSA mixer.
HARDWARE_MIXER_MODE=unity

# Якщо фізичний DAC ще не з'явився або був від'єднаний, MASTER тимчасово
# маршрутизується в беззвучний PARKING_SINK. Логічні шини, API та збережена
# гучність при цьому продовжують працювати; watcher автоматично підключить DAC.
