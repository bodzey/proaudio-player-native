# AUTO ігнорує auto_null та службові шини, віддаючи перевагу USB-виходу.
# Для Docker точний вихід зберігає інтерактивна команда select-audio.
PHYSICAL_SINK=AUTO
SAMPLE_RATE=48000
MUSIC_SINK=proaudio_player_music
ALERT_SINK=proaudio_player_alert
LOOPBACK_LATENCY_MSEC=100
# MASTER працює у програмному PipeWire/Pulse шарі. 100% = 0 dB.
OUTPUT_VOLUME_PERCENT=100
# unity: для активної ALSA-карти безпечно виставляти playback-контроли з dB-шкалою на 0 dB.
# Контроли без достовірної dB-шкали, capture/boost/gain та інші неоднозначні контроли не змінюються.
# off: взагалі не торкатися апаратного ALSA mixer.
HARDWARE_MIXER_MODE=unity
SINK_WAIT_SECONDS=30
