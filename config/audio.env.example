# AUTO ігнорує auto_null та службові шини. Автовибір не надає переваги USB/I2S/PCI:
# спочатку використовується активний фізичний sink, інакше стабільний fallback за назвою.
PHYSICAL_SINK=AUTO

# Поточний production runtime використовує спільний rate для логічних шин.
# Adaptive/native rate policy буде окремим capability-aware шаром, без hardcode під конкретний DAC.
SAMPLE_RATE=48000
AUDIO_CHANNELS=2

MUSIC_SINK=proaudio_player_music
ALERT_SINK=proaudio_player_alert
MASTER_SINK=proaudio_player_master
LOOPBACK_LATENCY_MSEC=100

# MASTER працює у програмному PipeWire/Pulse шарі. 100% = 0 dB, positive gain не використовується.
OUTPUT_VOLUME_PERCENT=100

# unity: ініціалізувати достовірні ALSA playback-контроли біля 0 dB без positive gain.
# capture/input/boost/gain/tone та контроли без dB-шкали не змінюються.
# off: взагалі не торкатися апаратного ALSA mixer.
HARDWARE_MIXER_MODE=unity

# Фінальний linked safety limiter після сумування MUSIC + ALERT.
# Він не має input/makeup gain і ніколи не підсилює сигнал.
LIMITER_ENABLED=true
LIMITER_CEILING_DB=-1.0
LIMITER_LOOKAHEAD_MS=5.0
LIMITER_RELEASE_MS=100.0
LIMITER_OVERSAMPLE=4

SINK_WAIT_SECONDS=30
