# AUTO ігнорує службові ProAudio nodes. Автовибір не надає переваги USB/I2S/HDMI:
# вже активний фізичний sink утримується до його фактичного зникнення, інакше
# використовується стабільний fallback за назвою. Явний вибір Web UI зберігається
# окремо у /var/lib/proaudio-player-alert/audio-output.env.
PHYSICAL_SINK=AUTO

# Внутрішній mix domain має стабільний processing rate. PipeWire виконує
# boundary resampling лише на межі з конкретним фізичним пристроєм.
SAMPLE_RATE=48000
AUDIO_CHANNELS=2

MUSIC_SINK=proaudio_player_music
ALERT_SINK=proaudio_player_alert
MASTER_SINK=proaudio_player_master
PARKING_SINK=proaudio_player_parking

# Внутрішні MUSIC/ALERT/MASTER і MASTER->hardware є native PipeWire links.
# Фізичний software sink завжди unity; користувацька MASTER-гучність живе
# тільки на MASTER_SINK.
OUTPUT_VOLUME_PERCENT=100

# MUSIC->MASTER, ALERT->MASTER і MASTER->hardware завжди unity. ALERT лишається
# на заданому користувачем рівні; під час повідомлення native control plane за
# потреби приглушує MUSIC, щоб не перевищувати лінійний peak-budget.

# unity: ініціалізувати лише достовірні ALSA playback-контроли біля 0 dB без
# positive gain. Якщо 0 dB мапиться на 0% (помилкова USB dB-шкала), control не
# приймається за unity і попередній raw-рівень відновлюється.
# off: взагалі не торкатися апаратного ALSA mixer.
HARDWARE_MIXER_MODE=unity

# Якщо фізичний DAC відсутній, MASTER маршрутизується в беззвучний PARKING_SINK.
# Логічні шини, API та збережена гучність при цьому залишаються працездатними;
# PipeWire registry watcher автоматично підключає DAC після hot-plug.
