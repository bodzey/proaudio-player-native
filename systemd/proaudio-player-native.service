[Unit]
Description=ProAudio Player Native control plane
After=dbus.service network-online.target proaudio-player-buses.service proaudio-player-mpd.service
Requires=proaudio-player-buses.service
Wants=dbus.service network-online.target proaudio-player-mpd.service
PartOf=proaudio-player-buses.service
ConditionPathExists=/usr/bin/proaudio-player-native

[Service]
Type=simple
User=proaudio-player
Group=proaudio-player
Environment=HOME=/var/lib/proaudio-player
Environment=XDG_RUNTIME_DIR=/run/proaudio-player
Environment=PULSE_SERVER=unix:/run/pulse/native
StateDirectory=proaudio-player-alert
StateDirectoryMode=0750
ExecStart=/usr/bin/proaudio-player-native --config /etc/proaudio-player-alert/config.yaml run
Restart=always
RestartSec=2
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
