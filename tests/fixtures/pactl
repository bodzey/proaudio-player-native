#!/usr/bin/env bash
set -euo pipefail

state="${MOCK_PACTL_STATE:?MOCK_PACTL_STATE is not set}"
command_name="${1:-}"
shift || true

case "$command_name" in
    info)
        printf 'Server Name: PulseAudio (on PipeWire)\n'
        ;;
    list)
        if [[ "${1:-} ${2:-}" == "short sinks" ]]; then
            if [[ -f "$state/sinks" ]]; then
                cat "$state/sinks"
            elif [[ -f "$state/physical-present" ]]; then
                printf '1\tmock_physical\tPipeWire\tfloat32le 2ch 48000Hz\tSUSPENDED\n'
            fi
        elif [[ "${1:-}" == "sink-inputs" ]]; then
            while IFS='|' read -r module kind arguments; do
                [[ "$kind" == "module-loopback" ]] || continue
                printf 'Sink Input #%s\n' "$((100 + module))"
                printf '\tOwner Module: %s\n' "$module"
                printf '\tmedia.name = "%s"\n' "$arguments"
            done <"$state/modules"
        elif [[ "${1:-}" == "sinks" ]]; then
            :
        fi
        ;;
    load-module)
        count=0
        [[ -f "$state/count" ]] && read -r count <"$state/count"
        count=$((count + 1))
        printf '%s\n' "$count" >"$state/count"
        if [[ -f "$state/fail-at" ]] && [[ "$(<"$state/fail-at")" == "$count" ]]; then
            exit 1
        fi
        printf '%s|%s|%s\n' "$count" "${1:-}" "${*:2}" >>"$state/modules"
        printf '%s\n' "$count"
        ;;
    unload-module)
        printf '%s\n' "${1:-}" >>"$state/unloaded"
        ;;
    get-sink-volume)
        if [[ -f "$state/sinks" ]]; then
            awk -v wanted="${1:-}" '$2 == wanted { found=1 } END { exit !found }' "$state/sinks"
        elif [[ "${1:-}" == "mock_physical" ]] && [[ ! -f "$state/physical-present" ]]; then
            exit 1
        fi
        printf 'Volume: front-left: 65536 / 100%% / 0.00 dB, front-right: 65536 / 100%% / 0.00 dB\n'
        ;;
    get-sink-mute)
        printf 'Mute: no\n'
        ;;
    set-default-sink|set-sink-volume|set-sink-mute|set-sink-input-volume)
        printf '%s|%s\n' "$command_name" "$*" >>"$state/calls"
        ;;
    subscribe)
        exit 0
        ;;
    *)
        printf 'unsupported mock pactl command: %s %s\n' "$command_name" "$*" >&2
        exit 2
        ;;
esac
