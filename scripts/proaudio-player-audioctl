#!/usr/bin/env bash
set -euo pipefail

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/proaudio-player}"
export PULSE_SERVER="${PULSE_SERVER:-unix:/run/pulse/native}"
CONFIG="/etc/proaudio-player-alert/config.yaml"
NATIVE_SERVICE="proaudio-player-native.service"

source_services=(
    proaudio-player-mpd.service
    proaudio-player-shairport.service
    proaudio-player-dlna.service
    proaudio-player-spotifyd.service
)

support_services=(
    proaudio-player-limiter.service
    proaudio-player-output-watch.service
    proaudio-player-audio-output.path
    proaudio-player-limiter.path
)

existing_units() {
    local unit
    for unit in "$@"; do
        [[ -f "/usr/lib/systemd/system/$unit" ]] && printf '%s\n' "$unit"
    done
}

mapfile -t existing_sources < <(existing_units "${source_services[@]}")
mapfile -t existing_support < <(existing_units "${support_services[@]}")

start_units() {
    (($# == 0)) || systemctl start "$@"
}

stop_units() {
    (($# == 0)) || systemctl stop "$@"
}

case "${1:-}" in
    start)
        systemctl start proaudio-player-buses.service
        start_units "${existing_support[@]}"
        start_units "${existing_sources[@]}"
        systemctl start "$NATIVE_SERVICE"
        ;;
    stop)
        systemctl stop "$NATIVE_SERVICE"
        stop_units "${existing_sources[@]}"
        stop_units "${existing_support[@]}"
        systemctl stop proaudio-player-buses.service
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    services)
        systemctl --no-pager status proaudio-player-buses.service "${existing_support[@]}" "${existing_sources[@]}" "$NATIVE_SERVICE"
        ;;
    status)
        /usr/bin/proaudio-player-native --config "$CONFIG" status
        ;;
    test-start|test-end|test-silence)
        /usr/bin/proaudio-player-native --config "$CONFIG" "$1"
        ;;
    test-cycle)
        /usr/bin/proaudio-player-native --config "$CONFIG" test-cycle --hold "${2:-5}"
        ;;
    sinks)
        pactl list short sinks
        ;;
    logs)
        journalctl -u "$NATIVE_SERVICE" -n "${2:-100}" --no-pager
        ;;
    *)
        echo "Використання: proaudio-player-audioctl {start|stop|restart|services|status|test-start|test-end|test-silence|test-cycle [секунди]|sinks|logs [рядки]}" >&2
        exit 2
        ;;
esac
