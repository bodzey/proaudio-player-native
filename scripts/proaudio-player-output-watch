#!/usr/bin/env bash
set -euo pipefail

AUDIO_ENV="${AUDIO_ENV:-/etc/proaudio-player-alert/audio.env}"
OUTPUT_ENV="${OUTPUT_ENV:-/var/lib/proaudio-player-alert/audio-output.env}"
BUS_SCRIPT="${BUS_SCRIPT:-/usr/libexec/proaudio-player/audio-buses.sh}"

load_config() {
    MUSIC_SINK=proaudio_player_music
    ALERT_SINK=proaudio_player_alert
    MASTER_SINK=proaudio_player_master
    PHYSICAL_SINK=AUTO
    PARKING_SINK=proaudio_player_parking
    SAMPLE_RATE=48000
    AUDIO_CHANNELS=2
    OUTPUT_VOLUME_PERCENT=100
    HARDWARE_MIXER_MODE=unity
    if [[ -f "$AUDIO_ENV" ]]; then
        # shellcheck disable=SC1090
        source "$AUDIO_ENV"
    fi
    if [[ -f "$OUTPUT_ENV" ]]; then
        local configured
        configured="$(awk -F= '$1 == "PHYSICAL_SINK" { print substr($0, index($0, "=") + 1); exit }' "$OUTPUT_ENV")"
        if [[ -n "$configured" ]]; then
            PHYSICAL_SINK="$configured"
        fi
    fi
    export MUSIC_SINK ALERT_SINK MASTER_SINK PARKING_SINK PHYSICAL_SINK
    export SAMPLE_RATE AUDIO_CHANNELS OUTPUT_VOLUME_PERCENT HARDWARE_MIXER_MODE
}

reconcile_output() {
    load_config
    "$BUS_SCRIPT" switch || true
}

export LC_ALL=C
reconcile_output

if [[ "${1:-watch}" == "once" ]]; then
    exit 0
fi

# pw-dump monitor mode follows native PipeWire registry changes without the
# PulseAudio compatibility protocol. One reconciliation per wall-clock second
# debounces the burst of node/port/link events generated by a single hot-plug.
while true; do
    last_second=""
    while IFS= read -r _event; do
        second="$(date +%s)"
        if [[ "$second" != "$last_second" ]]; then
            last_second="$second"
            reconcile_output
        fi
    done < <(pw-dump -m -N 2>/dev/null) || true
    sleep 1
done
