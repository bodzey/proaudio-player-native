#!/usr/bin/env bash
set -euo pipefail

AUDIO_ENV="${AUDIO_ENV:-/etc/proaudio-player-alert/audio.env}"
OUTPUT_ENV="${OUTPUT_ENV:-/var/lib/proaudio-player-alert/audio-output.env}"
STATE_FILE="${XDG_RUNTIME_DIR:-/run/proaudio-player}/proaudio-player-bus-modules"
BUS_SCRIPT="${BUS_SCRIPT:-/usr/libexec/proaudio-player/audio-buses.sh}"

load_config() {
    MUSIC_SINK=proaudio_player_music
    ALERT_SINK=proaudio_player_alert
    MASTER_SINK=proaudio_player_master
    PHYSICAL_SINK=AUTO
    PARKING_SINK=proaudio_player_parking
    SAMPLE_RATE=48000
    AUDIO_CHANNELS=2
    LOOPBACK_LATENCY_MSEC=100
    OUTPUT_VOLUME_PERCENT=100
    HARDWARE_MIXER_MODE=off
    if [[ -f "$AUDIO_ENV" ]]; then
        # shellcheck disable=SC1090
        source "$AUDIO_ENV"
    fi
    if [[ -f "$OUTPUT_ENV" ]]; then
        local configured
        configured="$(awk -F= '$1 == "PHYSICAL_SINK" { print substr($0, index($0, "=") + 1); exit }' "$OUTPUT_ENV")"
        if [[ -n "$configured" ]]; then
            PHYSICAL_SINK="$configured"
        fi
    fi
    export MUSIC_SINK ALERT_SINK MASTER_SINK PARKING_SINK SAMPLE_RATE AUDIO_CHANNELS
    export LOOPBACK_LATENCY_MSEC OUTPUT_VOLUME_PERCENT HARDWARE_MIXER_MODE
}

physical_candidates() {
    pactl list short sinks 2>/dev/null |
        awk -v music="${MUSIC_SINK:-proaudio_player_music}" \
            -v alert="${ALERT_SINK:-proaudio_player_alert}" \
            -v master="${MASTER_SINK:-proaudio_player_master}" '
            $2 != music && $2 != alert && $2 != master && $2 != "auto_null" &&
            $2 !~ /^proaudio_player_/ {
                priority = ($NF == "RUNNING" ? 0 : 1)
                print priority "\t" $2
            }' |
        sort -k1,1n -k2,2 |
        cut -f2-
}

sink_available() {
    local sink="$1"
    pactl get-sink-volume "$sink" >/dev/null 2>&1
}

current_output_target() {
    [[ -f "$STATE_FILE" ]] || return 0
    awk -F= '
        $1 == "OUTPUT_TARGET" { print substr($0, index($0, "=") + 1); found=1; exit }
        $1 == "PHYSICAL" { legacy=substr($0, index($0, "=") + 1) }
        END { if (!found) print legacy }
    ' "$STATE_FILE"
}

state_value() {
    local wanted="$1"
    [[ -f "$STATE_FILE" ]] || return 0
    awk -F= -v wanted="$wanted" '$1 == wanted { print substr($0, index($0, "=") + 1); exit }' "$STATE_FILE"
}

loopback_exists() {
    local module="$1"
    [[ "$module" =~ ^[0-9]+$ ]] || return 1
    pactl list sink-inputs 2>/dev/null | awk -v wanted="$module" '
        /^[[:space:]]*Owner Module:/ && $3 == wanted { found=1; exit }
        END { exit !found }'
}

physical_sink_is_unity() {
    local sink="$1"
    [[ "$(pactl get-sink-mute "$sink" 2>/dev/null | awk '{print $2}')" == "no" ]] || return 1
    pactl get-sink-volume "$sink" 2>/dev/null |
        tr '/,' '\n' |
        awk '
            BEGIN { valid=1 }
            /^[[:space:]]*[0-9]+%[[:space:]]*$/ {
                value=$1
                found=1
                if (value != "100%") valid=0
            }
            END { exit !(found && valid) }'
}

graph_healthy() {
    local output_target="$1"
    local music_loop alert_loop output_loop
    music_loop="$(state_value MUSIC_LOOP_MODULE)"
    alert_loop="$(state_value ALERT_LOOP_MODULE)"
    output_loop="$(state_value OUTPUT_LOOP_MODULE)"

    sink_available "${MUSIC_SINK:-proaudio_player_music}" \
        && sink_available "${ALERT_SINK:-proaudio_player_alert}" \
        && sink_available "${MASTER_SINK:-proaudio_player_master}" \
        && { [[ "$output_target" == "${PARKING_SINK:-proaudio_player_parking}" ]] \
            || physical_sink_is_unity "$output_target"; } \
        && loopback_exists "$music_loop" \
        && loopback_exists "$alert_loop" \
        && loopback_exists "$output_loop"
}

reconcile_output() {
    load_config

    local configured="${PHYSICAL_SINK:-AUTO}"
    local desired_physical=""
    local desired_target=""
    local current
    current="$(current_output_target)"

    if [[ "$configured" != "AUTO" ]] && sink_available "$configured"; then
        desired_physical="$configured"
    elif [[ "$configured" == "AUTO" \
        && -n "$current" \
        && "$current" != "${PARKING_SINK:-proaudio_player_parking}" \
        && "$current" != "auto_null" \
        && "$current" != proaudio_player_* ]] \
        && sink_available "$current"; then
        # AUTO chooses once and then keeps the routed physical sink until it
        # actually disappears. Sink RUNNING/SUSPENDED is a consequence of our
        # own loopback and must never make the policy oscillate between devices.
        desired_physical="$current"
    else
        desired_physical="$(physical_candidates | head -n 1 || true)"
    fi
    desired_target="${desired_physical:-${PARKING_SINK:-proaudio_player_parking}}"

    if [[ "$current" == "$desired_target" ]] && graph_healthy "$desired_target"; then
        return 0
    fi

    # Preserve an explicitly configured output while it is temporarily absent.
    # Only the environment of this switch operation falls back to AUTO.
    export PHYSICAL_SINK="${desired_physical:-AUTO}"
    echo "Audio routing: reconciling ${current:-<none>} -> $desired_target" >&2
    "$BUS_SCRIPT" switch
}

configured_snapshot() {
    if [[ ! -f "$OUTPUT_ENV" ]]; then
        printf '%s\n' AUTO
        return 0
    fi
    local configured
    configured="$(awk -F= '$1 == "PHYSICAL_SINK" { print substr($0, index($0, "=") + 1); exit }' "$OUTPUT_ENV")"
    printf '%s\n' "${configured:-AUTO}"
}

export LC_ALL=C
reconcile_output || true

if [[ "${1:-watch}" == "once" ]]; then
    exit 0
fi

# A physical sink/card/server event and a user selection persisted through the
# control API are both routing inputs. pactl does not emit an event when
# audio-output.env changes, so the subscription is sampled with a short timeout
# and the tiny one-line selection file is checked between events. This keeps the
# watcher dependency-free while making UI output changes deterministic.
last_config="$(configured_snapshot)"
while true; do
    event=""
    event_requires_reconcile=0

    if IFS= read -r -t 1 event; then
        case "$event" in
            *" on sink "*|*" on server "*|*" on card "*)
                event_requires_reconcile=1
                ;;
        esac
    else
        read_status=$?
        if ((read_status == 1)); then
            break
        fi
    fi

    current_config="$(configured_snapshot)"
    if [[ "$current_config" != "$last_config" ]]; then
        event_requires_reconcile=1
    fi

    if ((event_requires_reconcile)); then
        reconcile_output || true
        last_config="$(configured_snapshot)"
    fi
done < <(pactl subscribe)
